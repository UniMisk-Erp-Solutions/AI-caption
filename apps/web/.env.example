# Leave every value blank to run in Local Mode:
#   projects live in IndexedDB, video never leaves the browser, and captions are
#   designed by the built-in deterministic designer instead of Gemma.
# Fill these in to enable accounts, cloud storage and AI.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# On Vercel, set these three in Project Settings -> Environment Variables.
# Leave them unset for a local-mode demo deployment (no accounts, no AI).

# Only needed to run the end-to-end harness at /harness. Create the user once
# with the Supabase admin API, then put its credentials here (in .env.local,
# which is gitignored) rather than in source.
VITE_HARNESS_EMAIL=
VITE_HARNESS_PASSWORD=
